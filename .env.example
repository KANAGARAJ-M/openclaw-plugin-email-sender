# OpenClaw Email Sender Plugin Environment Variables

# SMTP Configuration (Sending Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_TYPE=basic
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME="OpenClaw Assistant"
SMTP_FROM_ADDRESS=your-email@gmail.com
SMTP_RATE_LIMIT=60

# OAuth2 SMTP Configuration (Optional)
# SMTP_AUTH_TYPE=oauth2
# SMTP_CLIENT_ID=your-google-client-id
# SMTP_CLIENT_SECRET=your-google-client-secret
# SMTP_REFRESH_TOKEN=your-refresh-token

# IMAP Configuration (Reading Inbox Emails)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_AUTH_TYPE=basic
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password
IMAP_DEFAULT_MAILBOX=INBOX

# Security Allowlist / Restrictions (Comma-separated)
ALLOWED_DOMAINS=company.com,partner.org
